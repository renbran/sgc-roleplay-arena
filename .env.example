# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─── App auth (gates the whole training app) ─────────────────────────────────
# Password that interns/SDRs enter to access the roleplay arena.
# Looked up first from the AppConfig DB row ("app_password"), falling back to
# APP_PASSWORD if no DB value is set. Stored only server-side.
APP_PASSWORD="change-me-in-production"

# ─── Admin / ops auth (gates /api/admin/* and /api/memory) ──────────────────
# Bearer-token password. Required in production — routes fail closed if unset.
ADMIN_PASSWORD="change-me-in-production"

# ─── LLM providers (at least one required) ───────────────────────────────────
# Chat provider chain, in priority order: Zen (free tier) → Mistral → Groq.
# See src/lib/opencode.ts for the probe data behind the Zen model choice.
OPENCODE_API_KEY=""
ZEN_BASE_URL="https://opencode.ai/zen/v1"
ZEN_MODEL="ling-3.0-flash-free"
MISTRAL_API_KEY=""
GROQ_API_KEY=""
# Optional scorer provider
ANTHROPIC_API_KEY=""

# ─── Voice (ASR + TTS) ───────────────────────────────────────────────────────
# HuggingFace speech-to-speech FastAPI wrapper (self-hosted, CPU mode).
# When set, HF is the primary provider for both STT and TTS; Deepgram acts as
# fallback. Path expectations: <HF_STT_URL>/v1/stt, <HF_TTS_URL>/v1/tts.
# See mini-services/hf-speech/ for the wrapper service.
HF_STT_URL=""
HF_TTS_URL=""
# Shared secret for the self-hosted HF wrapper (X-Internal-Token header).
# Generate with: openssl rand -hex 32. Must match wrapper's INTERNAL_TOKEN.
# Leave empty to disable the check on the wrapper (insecure — only for local dev).
HF_INTERNAL_TOKEN=""
# Deepgram (fallback for both STT and TTS; also used as primary if HF URLs unset)
DEEPGRAM_API_KEY=""

# ─── Cross-session memory (mem0) ────────────────────────────────────────────
MEM0_API_KEY=""

# ─── Booking email + Odoo provisioning ──────────────────────────────────────
# Signing key for /api/booking/provision tokens. WITHOUT a real value, a
# hardcoded insecure fallback is used and anyone can forge a valid token —
# set this in production.
BOOKING_TOKEN_SECRET="generate-random-32-byte-hex"

# Resend transactional email; sender address (must be a verified domain)
RESEND_API_KEY=""
EMAIL_FROM="noreply@sgctech.ai"

# Odoo CRM credentials for the account-provisioning flow (optional — if unset,
# the booking endpoint still issues the Odoo email but doesn't create a user)
ODOO_URL=""
ODOO_DB=""
ODOO_ADMIN_USER="admin"
ODOO_ADMIN_PASSWORD=""

# ─── LiveKit (real-time voice agent — only needed if using mini-services) ──
LIVEKIT_URL="wss://your-livekit-instance.com"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
# LIVEKIT_ENABLE_DISPATCH="true"
# LIVEKIT_AGENT_NAME="test-agent"
